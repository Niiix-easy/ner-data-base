generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  document  String   @unique // Anti-fraud CPF/CNPJ
  password  String
  name      String?
  locale    String   @default("en-US")
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Organizations OrganizationMember[]
}

model Organization {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  defaultLocale   String   @default("en-US")
  defaultTimezone String   @default("UTC")
  defaultCurrency String   @default("USD")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  Members OrganizationMember[]
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           String       @default("VIEWER") // OWNER, ADMIN, BILLING, DEVELOPER, VIEWER
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  User           User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Project {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  slug           String       @unique
  region         String       @default("us-east-1")
  status         String       @default("ACTIVE")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model Subscription {
  id             String       @id @default(cuid())
  organizationId String
  planVersionId  String
  status         String       @default("TRIALING") // TRIALING, ACTIVE, PAST_DUE, UNPAID, CANCELED, PAUSED
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model ApiKey {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  name           String
  prefix         String
  keyHash        String
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([projectId])
  @@index([prefix])
}

model ApiKeyScope {
  id        String @id @default(cuid())
  apiKeyId  String
  scope     String

  @@unique([apiKeyId, scope])
  @@index([apiKeyId])
}

enum ResourceStatus {
  ACTIVE
  PAUSED
  SUSPENDED
  DELETED
}

model Resource {
  id             String         @id @default(cuid())
  organizationId String
  projectId      String
  type           String
  provider       String
  externalId     String?
  status         ResourceStatus @default(ACTIVE)
  metadata       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId])
  @@index([projectId])
  @@index([type])
  @@index([externalId])
}

model UsageAggregate {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String?
  meterId        String
  periodStart    DateTime
  periodEnd      DateTime
  quantity       BigInt   @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, projectId, meterId, periodStart, periodEnd])
  @@index([organizationId, periodStart, periodEnd])
  @@index([meterId, periodStart, periodEnd])
}

enum BillingCycleStatus {
  OPEN
  RATING
  RATED
  INVOICING
  INVOICED
  CLOSED
  FAILED
}

model BillingCycle {
  id             String             @id @default(cuid())
  organizationId String
  subscriptionId String
  periodStart    DateTime
  periodEnd      DateTime
  status         BillingCycleStatus @default(OPEN)
  ratedAt        DateTime?
  invoicedAt     DateTime?
  closedAt       DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([subscriptionId, periodStart, periodEnd])
  @@index([organizationId])
  @@index([status])
}

model InvoiceSequence {
  id             String @id @default(cuid())
  organizationId String
  year           Int
  value          Int    @default(0)

  @@unique([organizationId, year])
}

model Invoice {
  id             String       @id @default(cuid())
  organizationId String
  billingCycleId String
  currency       String       @default("USD")
  subtotal       BigInt       @default(0)
  discount       BigInt       @default(0)
  tax            BigInt       @default(0)
  total          BigInt       @default(0)
  status         String       @default("DRAFT") // DRAFT, OPEN, PAID, UNCOLLECTIBLE, VOID
  // IMMUTABLE ONCE ISSUED
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([billingCycleId])
}

model Payment {
  id             String       @id @default(cuid())
  organizationId String
  invoiceId      String
  paymentMethodId String?
  idempotencyKey String       @unique // Idempotency guarantee
  amount         BigInt
  currency       String       @default("USD")
  status         String       @default("PENDING") // PENDING, PROCESSING, SUCCEEDED, FAILED, REFUNDED
  providerRef    String?
  // IMMUTABLE
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([invoiceId])
}

enum PaymentMethodType {
  CARD
  BANK_TRANSFER
}

model PaymentMethod {
  id             String            @id @default(cuid())
  organizationId String
  provider       String
  providerId     String
  type           PaymentMethodType
  brand          String?
  last4          String?
  expMonth       Int?
  expYear        Int?
  isDefault      Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([organizationId])
}

enum CouponType {
  FIXED
  PERCENTAGE
}

model Coupon {
  id             String     @id @default(cuid())
  code           String     @unique
  type           CouponType
  value          BigInt
  maxRedemptions Int?
  redeemedCount  Int        @default(0)
  startsAt       DateTime?
  expiresAt      DateTime?
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model CouponRedemption {
  id             String   @id @default(cuid())
  couponId       String
  organizationId String
  invoiceId      String?
  redeemedAt     DateTime @default(now())

  @@unique([couponId, organizationId])
  @@index([organizationId])
}

model WebhookEvent {
  id             String       @id @default(cuid())
  organizationId String
  idempotencyKey String       @unique // Identidade protegida / Idempotência
  provider       String
  type           String
  payload        Json
  status         String       @default("PENDING") // PENDING, PROCESSED, FAILED
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  resource       String
  oldValue       Json?
  newValue       Json?
  // Append-only
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

// ----------------------------------------------------------------------
// Core Billing Entities: Products, Meters, Plans, Prices, Entitlements
// ----------------------------------------------------------------------

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  Meters      Meter[]
}

model Meter {
  id          String   @id @default(cuid())
  productId   String
  slug        String   @unique
  name        String
  unit        String
  aggregation String   @default("SUM")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  Product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model Plan {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  Versions    PlanVersion[]
}

model PlanVersion {
  id           String        @id @default(cuid())
  planId       String
  version      Int
  status       String        @default("ACTIVE")
  effectiveAt  DateTime      @default(now())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  Plan         Plan          @relation(fields: [planId], references: [id], onDelete: Restrict)
  Prices       Price[]
  Entitlements Entitlement[]
}

model Price {
  id              String      @id @default(cuid())
  planVersionId   String
  meterId         String?     // Null means base subscription price
  currency        String      @default("USD")
  unitAmount      BigInt
  billingInterval String      @default("MONTH")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  PlanVersion     PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
}

model Entitlement {
  id            String      @id @default(cuid())
  planVersionId String
  meterId       String?     // The resource type/meter this entitles
  limit         BigInt      // The included amount
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  PlanVersion   PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
}
