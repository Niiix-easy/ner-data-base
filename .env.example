# ── PostgreSQL ────────────────────────────────────────────────────────
POSTGRES_PASSWORD=troque_esta_senha
AUTHENTICATOR_PASSWORD=troque_esta_senha
AUTH_DB_PASSWORD=troque_esta_senha

# ── JWT — mesmo secret usado por REST, Auth e Realtime ────────────────
JWT_SECRET=troque_este_jwt_secret_com_no_minimo_32_caracteres

# ── Realtime (só usado se subir o profile "realtime") ──────────────────
REALTIME_ENC_KEY=troque_esta_chave_de_32_caracteres
REALTIME_SECRET_KEY_BASE=troque_esta_secret_key_base_com_64_caracteres

# ── MinIO / Storage (só usado se subir o profile "storage") ────────────
MINIO_ROOT_USER=neer-data-base
MINIO_ROOT_PASSWORD=troque_esta_senha

# ── Dashboard (Studio) — protege o SQL Editor e telas administrativas ──
STUDIO_ADMIN_EMAIL=neersoftwarebr@gmail.com
STUDIO_ADMIN_PASSWORD=25150605
STUDIO_SESSION_SECRET='642483de8083285d0f3cf89b29b7a2615cdf68c9c8c3c92af64b570f1f604caf'

# ── Login social (opcional — deixe em branco pra desativar um provider) ─
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Observability (opcional) ────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=admin

# ─────────────────────────────────────────────────────────────────────
# ZimaOS / rede local — IMPORTANTE
# ─────────────────────────────────────────────────────────────────────
# Troque pelo IP do seu ZimaOS na rede local (ex: 192.168.1.50) para que
# o Dashboard, o login (GoTrue) e o SDK funcionem quando acessados de
# OUTRO dispositivo na rede — "localhost" só funciona a partir do próprio
# servidor. Depois de mudar isso, rode `docker compose build dashboard`
# de novo (essas variáveis são embutidas no build do Dashboard).
PUBLIC_DASHBOARD_URL=http://192.168.0.58:3010
PUBLIC_GATEWAY_URL=http://192.168.0.58:8000
PUBLIC_CONTROL_PLANE_URL=http://192.168.0.58:3001

# Caminho onde os dados persistentes (banco, buckets) ficam no disco —
# aparece no gerenciador de arquivos do ZimaOS/CasaOS para backup fácil.
DATA_PATH=./neer-data-base-data

# ─────────────────────────────────────────────────────────────────────
# Portas — mude aqui se alguma colidir com algo que o ZimaOS já usa
# ─────────────────────────────────────────────────────────────────────
POSTGRES_PORT=5432
POOLER_PORT=6432
GATEWAY_PORT=8000
KONG_ADMIN_PORT=8001
CONTROL_PLANE_PORT=3001
DASHBOARD_PORT=3010
STORAGE_PORT=3002
FUNCTIONS_PORT=8787
GRAPHQL_PORT=5000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ─────────────────────────────────────────────────────────────────────
# Limites de memória — padrões pensados para hardware modesto (ex:
# ZimaBoard com 4-8GB de RAM). Ajuste se seu dispositivo tiver mais ou
# menos memória disponível. Total do profile "core": ~1.4GB.
# ─────────────────────────────────────────────────────────────────────
POSTGRES_MEM_LIMIT=512m
POOLER_MEM_LIMIT=64m
REST_MEM_LIMIT=128m
AUTH_MEM_LIMIT=128m
KONG_MEM_LIMIT=256m
CONTROL_PLANE_MEM_LIMIT=128m
DASHBOARD_MEM_LIMIT=256m
REALTIME_MEM_LIMIT=256m
MINIO_MEM_LIMIT=256m
STORAGE_MEM_LIMIT=128m
FUNCTIONS_MEM_LIMIT=128m
GRAPHQL_MEM_LIMIT=256m
REDIS_MEM_LIMIT=64m
