{
  "name": "nercloudlocal",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "pnpm --filter @neercloud/dashboard dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @neercloud/dashboard start",
    "db:generate": "pnpm --filter @neercloud/db prisma:generate",
    "db:migrate": "pnpm --filter @neercloud/db prisma:migrate",
    "db:push": "pnpm --filter @neercloud/db prisma:push",
    "db:studio": "pnpm --filter @neercloud/db prisma:studio",
    "db:seed": "pnpm --filter @neercloud/db prisma:seed"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
